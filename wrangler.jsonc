// Cloudflare Workers configuration, read by the build gate (`wrangler deploy --dry-run`),
// the Workers test project and `wrangler types` (rerun `npm run gen:worker-types` after
// any change here).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etsy-shop-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // global_fetch_strictly_public: outbound fetch() can only reach the public internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ETSY_TOKEN_VAULT", "class_name": "EtsyTokenVault" },
      { "name": "ONE_TIME_STORE", "class_name": "OneTimeStore" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EtsyTokenVault", "OneTimeStore"] }],
  // No ids here: Terraform (infra/) creates both namespaces, and the Deploy workflow
  // fills their ids into the generated wrangler.deploy.json.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }, { "binding": "SHOP_KV" }],
  // Staged photo uploads under uploads/<nonce>/. Terraform (infra/) owns the bucket
  // and its one-day lifecycle rule.
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "etsy-shop-uploads" }],
  // The daily views snapshot (and Etsy token refresh), 06:17 UTC.
  "triggers": { "crons": ["17 6 * * *"] },
  "vars": {
    // "true" only while looking up her Etsy ids for the allowlist. Never grants access.
    "ALLOWLIST_BOOTSTRAP": "false",
  },
  "secrets": {
    "required": [
      "ETSY_KEYSTRING",
      "ETSY_SHARED_SECRET",
      "ALLOWED_ETSY_USER_ID",
      "ALLOWED_ETSY_SHOP_ID",
      "TOKEN_ENC_KEYS",
      "TOKEN_ENC_KID",
      // The complete list of MCP client apps allowed to connect (README: "MCP clients").
      "MCP_CLIENTS",
      // HMAC key for photo upload links (32+ random bytes, base64).
      "UPLOAD_SIGNING_KEY",
    ],
  },
}
