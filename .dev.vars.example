# Copy to .dev.vars (gitignored) for `npm run dev`. In production these are
# Worker secrets: `npx wrangler secret put <NAME>`. See README.md.

# From your Etsy app (developer.etsy.com → Your apps).
ETSY_KEYSTRING=your-etsy-keystring
ETSY_SHARED_SECRET=your-etsy-shared-secret

# Her Etsy user and shop ids. Find them with bootstrap mode (README); until then
# "unset" makes every sign-in fail closed.
ALLOWED_ETSY_USER_ID=unset
ALLOWED_ETSY_SHOP_ID=unset

# Token-vault encryption keys: a JSON map of key id to a base64 256-bit key.
# Generate one with: printf '{"k1":"%s"}' "$(openssl rand -base64 32)"
TOKEN_ENC_KEYS={"k1":"replace-with-openssl-rand-base64-32"}
TOKEN_ENC_KID=k1

# The apps allowed to connect: a JSON list on one line (README: "MCP clients").
# Make each secret with: openssl rand -base64 32
MCP_CLIENTS=[{"id":"claude","name":"Claude","secret":"replace-with-openssl-rand-base64-32","redirectUris":["https://claude.ai/api/mcp/auth_callback","https://claude.com/api/mcp/auth_callback"]}]
